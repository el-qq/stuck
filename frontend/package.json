{
  "name": "stuck-frontend",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode github-pages-demo",
    "verify:demo-build": "node scripts/verify-demo-build.mjs",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:demo": "STUCK_DEMO_E2E=1 playwright test e2e/github-pages-demo.spec.ts"
  },
  "dependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/ui": "5.0.5",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@ibm/plex-mono": false,
    "@ibm/plex-sans": false
  }
}
